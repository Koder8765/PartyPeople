@model Website.Models.EventAttendeeViewModel

@{
    ViewData["Title"] = $"Manage Attendees for Event: {Model.Event.Description}";
}


<h2>@ViewData["Title"]</h2>

<form asp-action="Manage" asp-route-eventId="@Model.Event.Id" method="post">
    <div class="form-group">
        <label>Select attendees:</label>
        @foreach (var employee in Model.AllEmployees)
        {
            <div class="form-check">
                <input class="form-check-input"
                type="checkbox"
                name="selectedEmployeeIds"
                value="@employee.Id"
                id="employee_@employee.Id"
                @(Model.SelectedEmployeeIds.Contains(employee.Id) ? "checked" : "") />
                <label class="form-check-label" for="employee_@employee.Id">
                    @employee.FirstName @employee.LastName
                </label>
            </div>
        }
    </div>

    @if (Model.MaxCapacityExceeded)
    {
        <div class="alert alert-warning mt-3">
            <strong>Warning:</strong> The number of selected attendees has reached or exceeded the event's maximum capacity of @Model.Event.MaximumCapacity.
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Save Attendees</button>
</form>
